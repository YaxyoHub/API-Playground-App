    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card Background within 66dp safe zone (21 to 87) -->
    <path
        android:pathData="M30,24 L78,24 A8,8 0 0,1 86,32 L86,76 A8,8 0 0,1 78,84 L30,84 A8,8 0 0,1 22,76 L22,32 A8,8 0 0,1 30,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="24"
                android:endX="86"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#1E293B" />
                <item android:offset="1.0" android:color="#0F172A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top header line of terminal card -->
    <path
        android:pathData="M22,35 L86,35"
        android:strokeWidth="1.5"
        android:strokeColor="#334155" />

    <!-- Terminal dots: green, cyan, amber -->
